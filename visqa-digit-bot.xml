<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable type="">Initial Stake</variable>
    <variable type="">Stake</variable>
    <variable type="">Martingale Factor</variable>
    <variable type="">Target Profit</variable>
    <variable type="">Stop Loss</variable>
    <variable type="">Prediction 1</variable>
    <variable type="">Prediction 2</variable>
  </variables>
  <block type="trade_definition" id="trade_definition_block" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="trade_definition_market_block" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <field name="PRODUCT_TYPE_LIST">matched_differ</field>
        <field name="TYPE_LIST">DIGITDIFF</field>
        <field name="CANDLEINTERVAL_LIST">60</field>
        <field name="TIME_MACHINE_ENABLED">FALSE</field>
        <field name="RESTARTONERROR">TRUE</field>
        <statement name="SUBMARKET_STMT">
          <block type="trade_definition_contracttype" id="trade_definition_contracttype_block">
            <field name="TYPE_LIST">DIGITDIFF</field>
            <next>
              <block type="trade_definition_stake" id="trade_definition_stake_block">
                <field name="AMOUNT_LIST">1</field>
                <value name="AMOUNT">
                  <block type="variables_get" id="variables_get_stake">
                    <field name="VAR" id="Stake">Stake</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="variables_set_init_stake">
        <field name="VAR" id="Initial Stake">Initial Stake</field>
        <value name="VALUE">
          <block type="math_number" id="math_num_init">
            <field name="NUM">0.5</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="variables_set_current_stake">
            <field name="VAR" id="Stake">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="variables_get_init">
                <field name="VAR" id="Initial Stake">Initial Stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="variables_set_mart_factor">
                <field name="VAR" id="Martingale Factor">Martingale Factor</field>
                <value name="VALUE">
                  <block type="math_number" id="math_num_mart">
                    <field name="NUM">2</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="variables_set_tp_val">
                    <field name="VAR" id="Target Profit">Target Profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="math_num_tp">
                        <field name="NUM">10</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="variables_set_sl_val">
                        <field name="VAR" id="Stop Loss">Stop Loss</field>
                        <value name="VALUE">
                          <block type="math_number" id="math_num_sl">
                            <field name="NUM">50</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="variables_set_p1_val">
                            <field name="VAR" id="Prediction 1">Prediction 1</field>
                            <value name="VALUE">
                              <block type="math_number" id="math_num_p1">
                                <field name="NUM">3</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="variables_set_p2_val">
                                <field name="VAR" id="Prediction 2">Prediction 2</field>
                                <value name="VALUE">
                                  <block type="math_number" id="math_num_p2">
                                    <field name="NUM">6</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMIT_PURCHASE">
      <block type="purchase" id="purchase_block_main">
        <field name="PURCHASE_LIST">DIGITDIFF</field>
      </block>
    </statement>
    <statement name="BEFORE_PURCHASE">
      <block type="controls_if" id="controls_if_before">
        <value name="IF0">
          <block type="logic_operation" id="logic_op_and">
            <field name="OP">AND</field>
            <value name="A">
              <block type="logic_compare" id="logic_cmp_1">
                <field name="OP">NEQ</field>
                <value name="A">
                  <block type="last_digit" id="last_digit_1"></block>
                </value>
                <value name="B">
                  <block type="variables_get" id="variables_get_p1">
                    <field name="VAR" id="Prediction 1">Prediction 1</field>
                  </block>
                </value>
              </block>
            </value>
            <value name="B">
              <block type="logic_compare" id="logic_cmp_2">
                <field name="OP">NEQ</field>
                <value name="A">
                  <block type="last_digit" id="last_digit_2"></block>
                </value>
                <value name="B">
                  <block type="variables_get" id="variables_get_p2">
                    <field name="VAR" id="Prediction 2">Prediction 2</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
      </block>
    </statement>
    <statement name="AFTER_PURCHASE">
      <block type="controls_if" id="controls_if_after">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="contract_check_result_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="variables_set_reset_stake">
            <field name="VAR" id="Stake">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="variables_get_initial_ref">
                <field name="VAR" id="Initial Stake">Initial Stake</field>
              </block>
            </value>
            <next>
              <block type="controls_if" id="controls_if_target">
                <value name="IF0">
                  <block type="logic_compare" id="logic_cmp_target">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="total_profit" id="total_profit_block"></block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="variables_get_tp_ref">
                        <field name="VAR" id="Target Profit">Target Profit</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="text_print" id="text_print_congrats">
                    <value name="TEXT">
                      <block type="text" id="text_congrats_msg">
                        <field name="TEXT">Visqa ai congratulations 🎉 continue milking 🥳</field>
                      </block>
                    </value>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE0">
          <block type="variables_set" id="variables_set_martingale">
            <field name="VAR" id="Stake">Stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="math_arithmetic_mart">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <block type="variables_get" id="variables_get_curr_stake">
                    <field name="VAR" id="Stake">Stake</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="variables_get_mart_factor">
                    <field name="VAR" id="Martingale Factor">Martingale Factor</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="controls_if" id="controls_if_loss">
                <value name="IF0">
                  <block type="logic_compare" id="logic_cmp_loss">
                    <field name="OP">LTE</field>
                    <value name="A">
                      <block type="total_profit" id="total_profit_loss_block"></block>
                    </value>
                    <value name="B">
                      <block type="math_arithmetic" id="math_neg_sl">
                        <field name="OP">MULTIPLY</field>
                        <value name="A">
                          <block type="variables_get" id="variables_get_sl_ref">
                            <field name="VAR" id="Stop Loss">Stop Loss</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="math_minus_one">
                            <field name="NUM">-1</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="text_print" id="text_print_loss">
                    <value name="TEXT">
                      <block type="text" id="text_loss_msg">
                        <field name="TEXT">Visqa bot sorry let’s type again😭</field>
                      </block>
                    </value>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
