<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable type="">Initial Stake</variable>
    <variable type="">Stake</variable>
    <variable type="">Martingale Factor</variable>
    <variable type="">Target Profit</variable>
    <variable type="">Stop Loss</variable>
    <variable type="">Prediction 1</variable>
    <variable type="">Prediction 2</variable>
  </variables>
  <block type="trade_definition" id="trade_def" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_sel" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <field name="PRODUCT_TYPE_LIST">digits</field>
        <field name="TYPE_LIST">DIGITDIFF</field>
        <field name="CANDLEINTERVAL_LIST">60</field>
        <field name="TIME_MACHINE_ENABLED">FALSE</field>
        <field name="RESTARTONERROR">TRUE</field>
        <statement name="SUBMARKET_STMT">
          <block type="trade_definition_contracttype" id="contract_type" deletable="false" movable="false">
            <field name="TYPE_LIST">DIGITDIFF</field>
            <next>
              <block type="trade_definition_tradeoptions" id="trade_options_block" deletable="false" movable="false">
                <mutation has_first_barrier="false" has_barrier="false" has_prediction="true"></mutation>
                <field name="DURATION_UNIT_LIST">t</field>
                <value name="DURATION">
                  <block type="math_number" id="dur_val">
                    <field name="NUM">1</field>
                  </block>
                </value>
                <value name="AMOUNT">
                  <block type="variables_get" id="get_stake">
                    <field name="VAR" id="Stake">Stake</field>
                  </block>
                </value>
                <value name="PREDICTION">
                  <block type="variables_get" id="get_p1_trade">
                    <field name="VAR" id="Prediction 1">Prediction 1</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_stake">
        <field name="VAR" id="Initial Stake">Initial Stake</field>
        <value name="VALUE">
          <block type="math_number" id="num_init_stake">
            <field name="NUM">0.5</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="set_current_stake">
            <field name="VAR" id="Stake">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="get_init_stake">
                <field name="VAR" id="Initial Stake">Initial Stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="set_martingale">
                <field name="VAR" id="Martingale Factor">Martingale Factor</field>
                <value name="VALUE">
                  <block type="math_number" id="num_martingale">
                    <field name="NUM">2</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="set_tp">
                    <field name="VAR" id="Target Profit">Target Profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_tp">
                        <field name="NUM">10</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="set_sl">
                        <field name="VAR" id="Stop Loss">Stop Loss</field>
                        <value name="VALUE">
                          <block type="math_number" id="num_sl">
                            <field name="NUM">50</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="set_p1">
                            <field name="VAR" id="Prediction 1">Prediction 1</field>
                            <value name="VALUE">
                              <block type="math_number" id="num_p1">
                                <field name="NUM">3</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="set_p2">
                                <field name="VAR" id="Prediction 2">Prediction 2</field>
                                <value name="VALUE">
                                  <block type="math_number" id="num_p2">
                                    <field name="NUM">6</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMIT_PURCHASE">
      <block type="purchase" id="purchase_digit" deletable="false">
        <field name="PURCHASE_LIST">DIGITDIFF</field>
      </block>
    </statement>
    <statement name="BEFORE_PURCHASE">
      <block type="controls_if" id="check_predictions" deletable="false">
        <value name="IF0">
          <block type="logic_operation" id="op_and">
            <field name="OP">AND</field>
            <value name="A">
              <block type="logic_compare" id="cmp_1">
                <field name="OP">NEQ</field>
                <value name="A">
                  <block type="last_digit" id="ld_1"></block>
                </value>
                <value name="B">
                  <block type="variables_get" id="vg_p1">
                    <field name="VAR" id="Prediction 1">Prediction 1</field>
                  </block>
                </value>
              </block>
            </value>
            <value name="B">
              <block type="logic_compare" id="cmp_2">
                <field name="OP">NEQ</field>
                <value name="A">
                  <block type="last_digit" id="ld_2"></block>
                </value>
                <value name="B">
                  <block type="variables_get" id="vg_p2">
                    <field name="VAR" id="Prediction 2">Prediction 2</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
      </block>
    </statement>
    <statement name="AFTER_PURCHASE">
      <block type="controls_if" id="check_result">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="check_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="reset_stake">
            <field name="VAR" id="Stake">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="get_initial">
                <field name="VAR" id="Initial Stake">Initial Stake</field>
              </block>
            </value>
            <next>
              <block type="controls_if" id="check_target">
                <value name="IF0">
                  <block type="logic_compare" id="cmp_target">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="total_profit" id="tp_val"></block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="get_tp">
                        <field name="VAR" id="Target Profit">Target Profit</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="text_print" id="print_congrats">
                    <value name="TEXT">
                      <block type="text" id="txt_congrats">
                        <field name="TEXT">Visqa ai congratulations 🎉 continue milking 🥳</field>
                      </block>
                    </value>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE0">
          <block type="variables_set" id="apply_martingale">
            <field name="VAR" id="Stake">Stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="math_multi">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <block type="variables_get" id="get_current_stake">
                    <field name="VAR" id="Stake">Stake</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="get_mart_factor">
                    <field name="VAR" id="Martingale Factor">Martingale Factor</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
